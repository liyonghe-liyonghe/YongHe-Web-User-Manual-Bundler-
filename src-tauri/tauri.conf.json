{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "泳和-网页用户手册合成器",
  "version": "0.8.7",
  "identifier": "com.manualbundler.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "泳和-网页/用户手册合成器 v0.8.7",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "泳和-网页/用户手册合成器",
    "longDescription": "泳和-网页/用户手册合成器：选择输入目录 → 配置导航结构 → 一键生成单文件HTML用户手册",
    "resources": ["resources/pdfium.dll", "resources/pdfium-LICENSE.txt"]
  }
}
